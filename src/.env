# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ALERT_TOPIC=ddos-alerts
# Zookeeper & Kafka Ports
ZOOKEEPER_CLIENT_PORT=2181
KAFKA_PORT=9092

# Monitoring Stack Ports
PROMETHEUS_HOST_PORT=9099
PROMETHEUS_CONTAINER_PORT=9090
NODE_EXPORTER_PORT=9100
CADVISOR_HOST_PORT=8082
CADVISOR_CONTAINER_PORT=8080
GRAFANA_PORT=3000
TELEGRAM_NOTIFIER_HOST_PORT=8005
TELEGRAM_NOTIFIER_CONTAINER_PORT=8000

# CICFlowMeter Configuration
CIC_INTERFACE=ens33
CIC_OUTPUT_DIR=/output
CIC_CAPTURE_DURATION=60
CIC_LOG_LEVEL=INFO

# Flow Processor Configuration
FLOW_INPUT_DIR=/output
FLOW_KAFKA_BROKERS=kafka:9092
FLOW_KAFKA_TOPIC=network-flows
FLOW_BATCH_SIZE=1000
FLOW_FILTER_LOCAL_IPS=true
FLOW_LOG_LEVEL=INFO

# DDoS Detector Configuration
DDOS_MODEL_DIR=/models
DDOS_KAFKA_BROKERS=kafka:9092
DDOS_KAFKA_INPUT_TOPIC=network-flows
DDOS_KAFKA_OUTPUT_TOPIC=ddos-alerts
DDOS_WINDOW_SIZE=30
DDOS_ALERT_COOLDOWN=300
DDOS_METRICS_PORT=8000
DDOS_DETECTOR_HOST_PORT=8001
DDOS_DETECTOR_CONTAINER_PORT=8000


# DDoS Response Manager Configuration
