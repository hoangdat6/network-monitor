RESPONSE_REDIS_PORT=6379
RESPONSE_REDIS_DB=0
RESPONSE_NGINX_API_URL=http://nginx:8080/api
RESPONSE_API_PORT=5000
RESPONSE_DEFAULT_BLOCK_DURATION=3600
RESPONSE_MANAGER_HOST_PORT=5000
RESPONSE_MANAGER_CONTAINER_PORT=5000
RESPONSE_EXPORTER_PORT=9091
REDIS_PORT=6379

# Nginx Stack Ports
NGINX_HOST_PORT=8080
NGINX_CONTAINER_PORT=80
NGINX_STATUS_PORT=8081
