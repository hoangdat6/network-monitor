# =============================================================================
# Kafka Environment Configuration
# 
# Mục đích: Centralized configuration cho Kafka cluster
# Sử dụng: docker-compose --env-file .env up
# =============================================================================

# ======================
# KAFKA CONFIGURATION
# ======================

# Kafka brokers (comma-separated)
KAFKA_BROKERS=kafka:29092

# Kafka topics configuration
KAFKA_TOPIC_NETWORK_FLOWS=network-flows
KAFKA_TOPIC_PROCESSED_FLOWS=processed-flows
KAFKA_TOPIC_STREAM_ANALYTICS=stream-analytics
KAFKA_TOPIC_APPLICATION_LOGS=application-logs
KAFKA_TOPIC_SYSTEM_METRICS=system-metrics
KAFKA_TOPIC_SECURITY_EVENTS=security-events
KAFKA_TOPIC_DDOS_ALERTS=ddos-alerts
KAFKA_TOPIC_WEB_ATTACK_ALERTS=web-attack-alerts
KAFKA_TOPIC_ANOMALY_ALERTS=anomaly-alerts
KAFKA_TOPIC_MITIGATION_ACTIONS=mitigation-actions
KAFKA_TOPIC_ADMIN_NOTIFICATIONS=admin-notifications

# ======================
# FLUENT BIT CONFIGURATION
# ======================

# Kafka connection for Fluent Bit
FLUENT_BIT_KAFKA_BROKERS=kafka:29092

# Log file paths
NGINX_ACCESS_LOG_PATH=/var/log/nginx/access.log
NGINX_ERROR_LOG_PATH=/var/log/nginx/error.log
APP_LOG_PATH=/app/logs
FLOW_CSV_PATH=/output

# ======================
# APPLICATION CONFIGURATION
# ======================

# Environment
ENVIRONMENT=production
HOSTNAME=network-monitor

# Data processing
ENABLE_NORMALIZATION=true
BATCH_SIZE=1000
PROCESSING_WORKERS=4

# ======================
# MONITORING CONFIGURATION
# ======================

# Health check intervals (seconds)
HEALTH_CHECK_INTERVAL=30
KAFKA_RETRY_DELAY=5
KAFKA_MAX_RETRIES=10

# Metrics collection
ENABLE_METRICS=true
METRICS_INTERVAL=60

# ======================
# SECURITY CONFIGURATION
# ======================

# Authentication (disabled for development)
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN

# ======================
# PERFORMANCE TUNING
# ======================

# Memory settings
KAFKA_HEAP_SIZE=1G
ZOOKEEPER_HEAP_SIZE=512M

# Network settings
KAFKA_SOCKET_SEND_BUFFER_BYTES=102400
KAFKA_SOCKET_RECEIVE_BUFFER_BYTES=102400

# Batch settings
KAFKA_BATCH_SIZE=16384
KAFKA_LINGER_MS=10
KAFKA_COMPRESSION_TYPE=snappy

# ======================
# DATA RETENTION
# ======================

# Default retention (7 days)
KAFKA_DEFAULT_RETENTION_MS=604800000

# Log cleanup
KAFKA_LOG_CLEANUP_POLICY=delete
KAFKA_LOG_SEGMENT_MS=86400000

# ======================
# DEVELOPMENT/DEBUG
# ======================

# Logging levels
LOG_LEVEL=INFO
KAFKA_LOG_LEVEL=INFO
FLUENT_BIT_LOG_LEVEL=info

# Debug flags
DEBUG_MODE=false
VERBOSE_LOGGING=false