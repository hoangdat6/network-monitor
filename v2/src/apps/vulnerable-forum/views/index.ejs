<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><% if (typeof search !== 'undefined' && search) { %>Tìm kiếm: <%= search %> - <% } else { %>Trang chủ - <% } %>Forum</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <header>
        <div class="container">
            <div class="header-content">
                <div class="logo">
                    <h1><a href="/">Forum</a></h1>
                </div>
                
                <form class="search-form" action="/" method="GET">
                    <input 
                        type="text" 
                        name="search" 
                        placeholder="Tìm kiếm bài viết..." 
                        value="<%= typeof search !== 'undefined' ? search : '' %>"
                    >
                    <button type="submit">
                        <i class="fas fa-search"></i>
                    </button>
                </form>
                
                <div class="nav-links">
                    <a href="/" class="btn btn-secondary">
                        <i class="fas fa-home"></i> Trang chủ
                    </a>
                    <a href="/create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Viết bài
                    </a>
                </div>
            </div>
        </div>
    </header>

    <main>
        <div class="container">
            <% if (typeof search !== 'undefined' && search) { %>
                <div style="margin-bottom: 2rem; text-align: center;">
                    <h2 class="page-title">Kết quả tìm kiếm: "<%= search %>"</h2>
                    <a href="/" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Xem tất cả bài viết
                    </a>
                </div>
            <% } else { %>
                <h1 class="page-title">
                    <i class="fas fa-comments"></i> Forum - Tất cả bài viết
                </h1>
            <% } %>

            <% if (posts && posts.length > 0) { %>
                <div class="posts-grid">
                    <% posts.forEach(post => { %>
                        <article class="post-card">
                            <h2 class="post-title">
                                <a href="/post/<%= post.id %>"><%= post.title %></a>
                            </h2>
                            
                            <div class="post-meta">
                                <span>
                                    <i class="fas fa-user"></i> 
                                    <strong><%= post.author %></strong>
                                </span>
                                <span>
                                    <i class="fas fa-calendar"></i> 
                                    <%= new Date(post.created_at).toLocaleDateString('vi-VN', {
                                        year: 'numeric',
                                        month: 'long',
                                        day: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                    }) %>
                                </span>
                            </div>
                            
                            <div class="post-excerpt">
                                <%= post.content.length > 200 ? post.content.substring(0, 200) + '...' : post.content %>
                            </div>
                            
                            <a href="/post/<%= post.id %>" class="read-more">
                                Đọc thêm <i class="fas fa-arrow-right"></i>
                            </a>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="no-posts">
                    <i class="fas fa-inbox"></i>
                    <% if (typeof search !== 'undefined' && search) { %>
                        <h3>Không tìm thấy bài viết nào</h3>
                        <p>Thử tìm kiếm với từ khóa khác hoặc <a href="/">xem tất cả bài viết</a></p>
                    <% } else { %>
                        <h3>Chưa có bài viết nào</h3>
                        <p>Hãy là người đầu tiên <a href="/create">tạo bài viết</a>!</p>
                    <% } %>
                </div>
            <% } %>

            <div style="text-align: center; margin-top: 3rem;">
                <a href="/create" class="btn btn-primary" style="font-size: 1.1rem; padding: 1rem 2rem;">
                    <i class="fas fa-plus"></i> Tạo bài viết mới
                </a>
            </div>
        </div>
    </main>

    <script>
        // Simple JavaScript for enhanced UX
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-focus search input when pressing '/' key
            document.addEventListener('keydown', function(e) {
                if (e.key === '/' && e.target.tagName !== 'INPUT' && e.target.tagName !== 'TEXTAREA') {
                    e.preventDefault();
                    const searchInput = document.querySelector('.search-form input');
                    if (searchInput) {
                        searchInput.focus();
                        searchInput.select();
                    }
                }
            });

            // Smooth scroll for anchor links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth'
                        });
                    }
                });
            });

            // Form validation
            const forms = document.querySelectorAll('form[data-validate]');
            forms.forEach(form => {
                form.addEventListener('submit', function(e) {
                    const requiredFields = form.querySelectorAll('[required]');
                    let isValid = true;

                    requiredFields.forEach(field => {
                        if (!field.value.trim()) {
                            isValid = false;
                            field.style.borderColor = '#dc3545';
                        } else {
                            field.style.borderColor = '#e9ecef';
                        }
                    });

                    if (!isValid) {
                        e.preventDefault();
                        alert('Vui lòng điền đầy đủ thông tin!');
                    }
                });
            });
        });
    </script>
</body>
</html>
